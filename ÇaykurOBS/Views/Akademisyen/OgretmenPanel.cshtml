@{
    Layout = "~/Views/Shared/AkademisyenLayout.cshtml";
}

<div class="dashboard-container">

    <div class="hosgeldin-karti">
        <div class="hosgelidn-yazisi">
            <h1>Hoşgeldin @Context.Session.GetString("KullaniciAdSoyad"),</h1>
            <p>ÇaykurOBS Akademisyen paneline hoş geldiniz. Buradan not girişi yapabilir,verdiğiniz dersleri görüntüleyebilir ve daha fazlasını yapabilirsiniz.</p>
        </div>
        <div class="hosgeldin-logo">
            <img src="~/ArkaPlanResimleri/CaykurLogo.png" alt="Hoşgeldin Logo" />
        </div>
    </div>

    <div class="dashboard-cift-grid">
        <div class="bilgi-kutusu">
            <h3 class="bilgi-baslik"><i class="bx bx-calendar"></i> Dönem Bilgilendirmesi</h3>
            <ul class="bilgi-liste">
                <li><strong>Not Girişleri:</strong> Sınav sonuçları sınav tarihinden itibaren 14 gün içinde ilan edilmelidir.</li>
                <li><strong>Sınavlar:</strong> Ara sınav ve final tarihleri fakülte panosunda ilan edilir.</li>
                <li><strong>Sınav Görevlisi Listesi:</strong> Her sınav için görevli listesi, sınav tarihleri duyurusuyla beraber fakülte panosunda ilan edilir.</li>
                <li><strong>Sınav Dönemi Ders:</strong> Sınav dönemlerinde derslere online bir şekilde zoom uygulaması üzerinden devam edilir. Bu dönemlerde yoklama alınmaz.</li>
                <li><strong> Harf Notu ve Bağıl Değerlendirme:</strong> Vize ve Final notları girildikten sonra sistem fakültenin ilgili sınav notu oranlarına göre harf notlarını ve ortalamayı otomatik hesaplar.</li>
            </ul>
        </div>

        <div class="bilgi-kutusu">
            <h3 class="bilgi-baslik"><i class="bx bx-info-circle"></i> Çaykur Kurumsal Portal</h3>
            <p class="bilgi-metin">
                Çay İşletmeleri Genel Müdürlüğü bünyesindeki eğitim süreçleri ve kurumsal duyurular için resmi web sayfasını ziyaret edebilirsiniz.
            </p>
            <a href="https://www.caykur.gov.tr/AnaSayfa.aspx" target="_blank" class="kurumsal-link-btn">
                Resmi Siteye Git <i class="bx bx-link-external"></i>
            </a>
        </div>
    </div>
</div>
    