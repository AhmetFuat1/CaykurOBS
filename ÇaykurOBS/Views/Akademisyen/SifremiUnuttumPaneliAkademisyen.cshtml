@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SifreYenilemeEkrani </title>
    <link rel="stylesheet" href="~/css/StyleKodlar.css">
</head>
<body>
    <div class="style">
        <img src="~/ArkaPlanResimleri/sifresifirlamaEkraniFotosu.jpg" alt="Çaykur Arka Plan" class="style__img">

        <form action="/Akademisyen/SifremiUnuttumPaneliAkademisyen" class="style__form" method="post">
            <h1 class="style__title">Şifre Yenileme Ekranı</h1>
            @if (ViewBag.HataMesaji != null)
            {
                <div class="style__viewbag">
                    @ViewBag.HataMesaji
                </div>
            }
            <div class="style__content">
                <div class="style__box">
                    <div class="style__box-input">
                        <input type="password" required class="style__input" name="AkademisyenSifre" placeholder=" ">
                        <label class="style__label">Şifre</label>
                    </div>
                </div>
                <div class="style__box">
                    <div class="style__box-input">
                        <input type="password" required class="style__input" name="AkademisyenSifreTekrar" placeholder=" ">
                        <label class="style__label">Şifre Tekrar</label>
                    </div>
                </div>
            </div>
            <button type="submit" class="style__button">Şifreyi Sıfırla</button>
        </form>
    </div>

</body>
</html>


