@{
    Layout = "~/Views/Shared/AkademisyenLayout.cshtml";
}

<div class="custom-table-container">
    <h1 class="style__title">Dersi Alan Öğrenciler ve Notları Listesi</h1>
    <div class="arama-kapsayici">
        <button type="button" id="temizle-btn" class="arama-temizle-btn" style="display:none;">&#10005;</button>
        <div class="arama-input-kutu">
            <input type="text" class="arama-input" id="arama-input" placeholder="Ara...🔎">
        </div>
        <button type="button" class="arama-btn" onclick="aramaYap()">Ara</button>
    </div>
    <table class="custom-table" id="tablo">
        <thead>
            <tr>
                <th> Ders İsmi </th>
                <th> Kredisi </th>
                <th>Ders Kodu</th>
                <th onclick="sirala(3)" style="cursor: pointer; user-select: none;">
                    Dersi Alan Öğrenci <span class="sirala-ikon"> ↕️</span>
                </th>
                <th>VizeNotu</th>
                <th>FinalNotu</th>
                <th>ButunlemeNotu</th>
                <th onclick="sirala(7)" style="cursor: pointer; user-select: none;">
                    Ortalaması <span class="sirala-ikon"> ↕️</span>
                </th>
                <th onclick="sirala(8)" style="cursor: pointer; user-select: none;">
                    Harf Notu <span class="sirala-ikon"> ↕️</span>
                </th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count > 0)
            {
                @foreach (var notogr in Model)
                {
                    <tr>
                        <td>@notogr.DersAdi</td>
                        <td>@notogr.DersKredisi</td>
                        <td>@notogr.DersKodu</td>
                        <td>@notogr.OgrenciAdiSoyadi</td>
                        <td>@notogr.VizeNotu</td>
                        <td>@notogr.FinalNotu</td>
                        <td>@notogr.ButunlemeNotu</td>
                        <td>@notogr.Ortalama</td>
                        <td>@notogr.HarfNotu</td>
                        <td>
                            <a href="/Akademisyen/NotDuzenleme?DersID=@notogr.DersID&OgrenciID=@notogr.OgrenciID" class="style__btn-edit">
                                Notu Düzenle
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<script src="~/js/SiralamaScripti.js"></script>
<script src="~/js/AramaScripti.js"></script>