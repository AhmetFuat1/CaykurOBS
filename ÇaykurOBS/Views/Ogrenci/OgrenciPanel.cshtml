@{
    Layout = "~/Views/Shared/OgrenciLayout.cshtml";
}

<div class="dashboard-container">

    <div class="hosgeldin-karti">
        <div class="hosgelidn-yazisi">
            <h1>Hoş geldin @Context.Session.GetString("KullaniciAdSoyad"),</h1>
            <p>ÇaykurOBS Öğrenci paneline hoş geldiniz. Buradan notlarınızı görüntüleyebilir, aldığınız dersleri görüntüleyebilir ve daha fazlasını yapabilirsiniz.</p>
        </div>
        <div class="hosgeldin-logo">
            <img src="~/ArkaPlanResimleri/CaykurLogo.png" alt="Hoşgeldin Logo" />
        </div>
    </div>

    <div class="dashboard-cift-grid">
        <div class="bilgi-kutusu">
            <h3 class="bilgi-baslik"><i class="bx bx-calendar"></i> Dönem Bilgilendirmesi</h3>
            <ul class="bilgi-liste">
                <li><strong>Ders Seçimleri:</strong> Admin onayından sonra kesinleşir.</li>
                <li><strong>Sınavlar:</strong> Ara sınav ve final tarihleri fakülte panosunda ilan edilir.</li>
                <li><strong>Not İtirazı:</strong> Not açıklanma tarihinden itibaren 5 iş günüdür ve el yazısı dilekçe ile dekanlığa başvurulmalıdır.</li>
                <li><strong>Devamsızlık:</strong> Teorik derslerin %70'ine, laboratuvar derslerin %80'nine devam zorunludur.</li>
                <li><strong>Sınav Dönemi Ders:</strong>Sınav dönemlerinde derslere online bir şekilde zoom uygulaması üzerinden devam edilir.</li>
                <li><strong>Bütünleme:</strong> Sadece kaldığınız (FF) derslerden bütünlemeye girebilirsiniz; başarılı olunan derslerden not yükseltme amacıyla sınava girilemez.</li>
            </ul>
        </div>

        <div class="bilgi-kutusu">
            <h3 class="bilgi-baslik"><i class="bx bx-info-circle"></i> Çaykur Kurumsal Portal</h3>
            <p class="bilgi-metin">
                Çay İşletmeleri Genel Müdürlüğü bünyesindeki eğitim süreçleri ve kurumsal duyurular için resmi web sayfasını ziyaret edebilirsiniz.
            </p>
            <a href="https://www.caykur.gov.tr/AnaSayfa.aspx" target="_blank" class="kurumsal-link-btn">
                Resmi Siteye Git <i class="bx bx-link-external"></i>
            </a>
        </div>
    </div>
</div>
