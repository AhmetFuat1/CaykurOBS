@{
    Layout = "~/Views/Shared/OgrenciLayout.cshtml";
}

<div class="custom-table-container" id="tablo">
    <h1 class="style__title">Ders Alma Ekranı</h1>
    <div class="arama-kapsayici">
        <button type="button" id="temizle-btn" class="arama-temizle-btn" style="display:none;">&#10005;</button>
        <div class="arama-input-kutu">
            <input type="text" class="arama-input" id="arama-input" placeholder="Ara...🔎">
        </div>
        <button type="button" class="arama-btn" onclick="aramaYap()">Ara</button>
    </div>

    <p><strong>Seçilen Toplam Kredi:</strong> 
        <span id="krediGosterge">@(ViewBag.MevcutKredi ?? 0)</span>
    / 30</p>

    <form action="/Ogrenci/DersSeciminiKaydet" method="post">

        <table class="custom-table">
            <thead>
                <tr>
                    <th>Seç</th>
                    <th onclick="sirala(1)" style="cursor: pointer; user-select: none;">
                        Ders İsmi <span class="sirala-ikon"> ↕️</span>
                    </th>
                    <th onclick="sirala(2)" style="cursor: pointer; user-select: none;">
                        Kredisi <span class="sirala-ikon"> ↕️</span>
                    </th>
                    <th>Ders Kodu</th>
                    <th onclick="sirala(4)" style="cursor: pointer; user-select: none;">
                        Dersi Veren Akademisyen<span class="sirala-ikon"> ↕️</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count > 0)
                {
                    @foreach (var drs in Model)
                    {
                        <tr>
                            <td>
                                <input type="checkbox"
                                       name="secilenDersler"
                                       value="@drs.DersID"
                                       data-kredi="@drs.DersKredisi"
                                       onchange="krediHesapla(this)" />
                            </td>
                            <td>@drs.DersAdi</td>
                            <td>@drs.DersKredisi</td>
                            <td>@drs.DersKodu</td>
                            <td>@drs.OgretmenAdiSoyadi</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <br />
        <button type="submit" class="style__btn-edit">Seçimleri Kaydet</button>

    </form> 
</div>


<script>
    var toplam = @(ViewBag.MevcutKredi ?? 0);

    function krediHesapla(kutu) {
        var kredi = parseInt(kutu.getAttribute("data-kredi"));

        if (kutu.checked) {
            if (toplam + kredi > 30) {
                alert("30 krediyi aşamazsınız!");
                kutu.checked = false;
            } else {
                toplam += kredi;
            }
        } else {
            toplam -= kredi;
        }
        document.getElementById("krediGosterge").innerText = toplam;
    }
</script>
<script src="~/js/SiralamaScripti.js"></script>
<script src="~/js/AramaScripti.js"></script>