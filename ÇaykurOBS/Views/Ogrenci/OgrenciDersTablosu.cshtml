@{
    Layout = "~/Views/Shared/OgrenciLayout.cshtml";
}

<div class="custom-table-container">
    <h1 class="style__title">Ders Listesi</h1>
    <table class="custom-table">
        <thead>
            <tr>
                <th>Ders İsmi</th>
                <th>Kredisi</th>
                <th>Ders Kodu</th>
                <th>Durum</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count > 0)
            {
                @foreach (var ogr in Model)
                {
                    <tr>
                        <td>@ogr.DersAdi</td>
                        <td>@ogr.DersKredisi</td>
                        <td>@ogr.DersKodu</td>
                        <td>@ogr.Durum</td>
                    </tr>
                }
            }
        </tbody>
    </table>

</div>
