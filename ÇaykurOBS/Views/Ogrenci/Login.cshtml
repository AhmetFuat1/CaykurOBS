@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LoginEkrani</title>
    <link rel="stylesheet" href="~/css/StyleKodlar.css">

</head>
<body>
    <div class="style">
        <img src="~/ArkaPlanResimleri/EpostaveNumaraDogrulamaEkrani.jpg" alt="Çaykur Arka Plan" class="style__img">

        <form action="/Ogrenci/GirisYap" class="style__form" method="post">
            <h1 class="style__title">ÇAYKUR ÖĞRENCİ BİLGİ SİSTEMİ</h1>

            @if (ViewBag.HataMesaji != null)
            {
                <div class="style__viewbag">
                    @ViewBag.HataMesaji
                </div>
            }

            <div class="style__content">
                <div class="style__box">
                    <div class="style__box-input">
                        <input type="text" required class="style__input" name="OgrenciNumarasi" maxlength="9" placeholder="">
                        <label class="style__label">Öğrenci Numarası</label>
                    </div>
                </div>

                <div class="style__box">
                    <div class="style__box-input">
                        <input type="password" required class="style__input" name="Sifre" placeholder="">
                        <label class="style__label">Şifre</label>
                    </div>
                </div>
            </div>

            <div class="style__check">
                <div class="style__check-group">
                    <input type="checkbox" class="style__check-input" name="BeniHatirla" value="true">
                    <label class="style__check-label">Beni Hatırla</label>
                </div>

                <a href="/Akademisyen/OgretmenGiris" class="style__forgot">Akedemisyen Girişi İçin Tıklayınız</a>
            </div>

            <button type="submit" class="style__button">Giriş</button>
        </form>
    </div>


</body>
</html>
