<!DOCTYPE html>

<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OgrenciEkrani </title>
    <link rel="stylesheet" href="~/css/PanelKodlar.css">

</head>
<body>
    <!-- -----------Menuler------------ -->
    <div class="container">
        <div class="navigation">
            <ul>
                <li>
                    <a href="~/Ogrenci/OgrenciPanel">
                        <span class="icon">
                            <ion-icon name="person-circle-outline"></ion-icon>
                        </span>
                        <span class="title">Öğrenci Paneli</span>
                    </a>
                </li>

                <li>
                    <a href="~/Ogrenci/DersTablosu">
                        <span class="icon">
                            <ion-icon name="book-outline"></ion-icon>
                        </span>
                        <span class="title">Ders Seçimi</span>
                    </a>
                </li>

                <li>
                    <a href="/Ogrenci/OgrenciDersTablosu">
                        <span class="icon">
                            <ion-icon name="book-outline"></ion-icon>
                        </span>
                        <span class="title">Ders Listesi</span>
                    </a>
                </li>

                <li>
                    <a href="/Ogrenci/NotOgrenciTablosu">
                        <span class="icon">
                            <ion-icon name="pencil-outline"></ion-icon>
                        </span>
                        <span class="title">Sınav Sonuçları</span>
                    </a>
                </li>

                <li>
                    <a href="/Ogrenci/CikisYap">
                        <span class="icon"><ion-icon name="exit-outline"></ion-icon></span>
                        <span class="title">Oturumu Kapat</span>
                    </a>
                </li>
            </ul>
        </div>

                <div class="main">
			        @RenderBody()
			    </div>
    </div>
    <!-- ionicons kullandım burda ikon çekeceğim yeri tanıttım -->
    <script type="module" src="https://unpkg.com/ionicons@8.0.13/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@8.0.13/dist/ionicons/ionicons.js"></script>
  </body>
</html>
