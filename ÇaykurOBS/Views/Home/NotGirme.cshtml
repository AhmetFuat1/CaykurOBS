@{
    Layout = "~/Views/Shared/AkademisyenLayout.cshtml";
}

    <div class="style">

        <form action="/Home/NotKaydet" class="style__form" method="post">
        <h1 class="style__title">Not Giriş Ekranı</h1>
         
            @if (ViewBag.HataMesaji != null)
            {
                <div class="style__viewbag">
                    @ViewBag.HataMesaji
                </div>
            }
            <div class="style__content">
                <div class="style__box">
                    <i class="bx bx-lock-alt"></i>

                <input type="hidden" name="DersID" value="@ViewBag.SecilenDersID" />

                    <div class="style__box-input">
                        <input type="number" required class="style__input" name="VizeNotu" placeholder=" ">
                        <label class="style__label">Vize Notu</label>
                    </div>
                </div>
                <div class="style__box">
                    <i class="bx bx-lock-alt"></i>

                    <div class="style__box-input">
                        <input type="number" required class="style__input" name="FinalNotu"  placeholder=" ">
                        <label class="style__label">Final Notu</label>
                    </div>
                </div>

                <div class="style__box">
                    <i class="bx bx-lock-alt"></i>

                    <div class="style__box-input">
                        <input type="number" class="style__input" name="ButunlemeNotu" placeholder=" ">
                        <label class="style__label">Bütünleme Notu</label>
                    </div>
                </div>
            <div class="style__box">
                <i class="bx bx-user"> </i>
                <div class="style__box-input">
                    <select name="OgrenciID" required class="style__input custom-select">
                        <option value="" disabled selected>Lütfen bir öğrenci seçiniz...</option>
                        @if (ViewBag.Ogrenciler != null)
                        {
                            @foreach (var ogr in (List<ÇaykurOBS.Models.DersSecimleri>)ViewBag.Ogrenciler)
                            {
                                <option value="@ogr.OgrenciID">
                                    @ogr.OgrenciAdiSoyadi
                                </option>
                            }
                        }
                </select>
                </div>
            </div>
            </div>

            <button type="submit" class="style__button">Kaydet</button> 

        </form>
    </div>



