@{
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

    <div class="style">

        <form action="/Home/KayitOl" class="style__form" method="post">
        <h1 class="style__title">Öğrenci Kayıt Ekranı</h1>
         
            @if (ViewBag.HataMesaji != null)
            {
                <div class="style__viewbag">
                    @ViewBag.HataMesaji
                </div>
            }
            <div class="style__content">
                <div class="style__box">
                    <i class="bx bx-lock-alt"></i>

                    <div class="style__box-input">
                        <input type="text" required class="style__input" name="OgrenciNumarasi" maxlength="9" placeholder=" ">
                        <label class="style__label">Öğrenci Numarası</label>
                    </div>
                </div>
                <div class="style__box">
                    <i class="bx bx-lock-alt"></i>

                    <div class="style__box-input">
                        <input type="text" required class="style__input" name="Isim" placeholder=" ">
                        <label class="style__label">İsim</label>
                    </div>
                </div>

                <div class="style__box">
                    <i class="bx bx-lock-alt"></i>

                    <div class="style__box-input">
                        <input type="text" required class="style__input" name="Soyisim" placeholder=" ">
                        <label class="style__label">Soyisim</label>
                    </div>
                </div>
            </div>

            <button type="submit" class="style__button">Kayıt Ekle</button> 

        </form>
    </div>



