@{
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<div class="custom-table-container">
    <h1 class="style__title">Ders Kaydı</h1>
    <div class="arama-kapsayici">
        <button type="button" id="temizle-btn" class="arama-temizle-btn" style="display:none;">&#10005;</button>
        <div class="arama-input-kutu">
            <input type="text" class="arama-input" id="arama-input" placeholder="Ara...🔎">
        </div>
        <button type="button" class="arama-btn" onclick="aramaYap()">Ara</button>
    </div>
    <table class="custom-table" id="tablo">
        <thead>
            <tr>
                <th onclick="sirala(0)" style="cursor: pointer; user-select: none;">
                    Ders İsmi <span class="sirala-ikon"> ↕️</span>
                </th>
                <th onclick="sirala(1)" style="cursor: pointer; user-select: none;">
                    Kredisi <span class="sirala-ikon"> ↕️</span>
                </th>
                <th onclick="sirala(2)" style="cursor: pointer; user-select: none;">
                    Dersi Veren Akademisyen <span class="sirala-ikon"> ↕️</span>
                </th>
                <th>Ders Kodu</th>
                <th onclick="sirala(4)" style="cursor: pointer; user-select: none;">
                    Öğrenci Adı Soyadı <span class="sirala-ikon"> ↕️</span>
                </th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count > 0)
            {
                @foreach (var drsscm in Model)
                {
                    <tr>
                        <td>@drsscm.DersAdi</td>
                        <td>@drsscm.DersKredisi</td>
                        <td>@drsscm.OgretmenAdiSoyadi</td>
                        <td>@drsscm.DersKodu</td>
                        <td>@drsscm.OgrenciAdiSoyadi</td>
						<td>@drsscm.Durum</td>
                        <td>
                            <a href="/Home/DersSecimOnaylama?DersID=@drsscm.DersID&OgrenciID=@drsscm.OgrenciID" class="style__btn-edit">
                                Onayla
                            </a>
                            <a href="/Home/DersSecimSilme?DersID=@drsscm.DersID&OgrenciID=@drsscm.OgrenciID" class="style__btn-delete">
                                Reddet
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<script src="~/js/SiralamaScripti.js"></script>
<script src="~/js/AramaScripti.js"></script>