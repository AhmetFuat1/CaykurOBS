@{
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

    <div class="dashboard-container">

        <div class="hosgeldin-karti">
               <div class="hosgelidn-yazisi">
                <h1>Hoşgeldin Admin,</h1>
                <p>ÇaykurOBS Yönetim paneline hoş geldiniz. Buradan kullanıcıları yönetebilir, dersleri görüntüleyebilir ve daha fazlasını yapabilirsiniz.</p>
               </div>
               <div class="hosgeldin-logo">
                      <img src="~/ArkaPlanResimleri/CaykurLogo.png" alt="Hoşgeldin Logo" />
                </div>
         </div>

    <div class="dashboard-cift-grid">
        <div class="bilgi-kutusu">
            <h3 class="bilgi-baslik"><i class="bx bx-calendar"></i> Dönem Bilgilendirmesi</h3>
            <ul class="bilgi-liste">
                <li><strong>Ders Onayları:</strong> Dönem başında öğrencilerin seçtiği dersler kontrol edilerek onaylanmalıdır.</li>
                <li><strong>Kullanıcı Yönetimi:</strong> Mezun olan veya ilişiği kesilen öğrenci/akademisyen kayıtları veritabanı bütünlüğü için silinmemeli, durumu pasife alınmalıdır.</li>
                <li><strong>Şifre Sıfırlama:</strong> Şifresini unutan kullanıcıların talepleri yüz yüze alındıktan sonra sistem üzerinden varsayılana çekilmelidir.</li>
                <li><strong>Yeni Ders Tanımlama:</strong> Eklenen yeni derslerin kod, kredi ve akademisyen eşleşmeleri dönem başlamadan önce eksiksiz tamamlanmalıdır.</li>
            </ul>
        </div>

        <div class="bilgi-kutusu">
            <h3 class="bilgi-baslik"><i class="bx bx-info-circle"></i> Çaykur Kurumsal Portal</h3>
            <p class="bilgi-metin">
                Çay İşletmeleri Genel Müdürlüğü bünyesindeki eğitim süreçleri ve kurumsal duyurular için resmi web sayfasını ziyaret edebilirsiniz.
            </p>
            <a href="https://www.caykur.gov.tr/AnaSayfa.aspx" target="_blank" class="kurumsal-link-btn">
                Resmi Siteye Git <i class="bx bx-link-external"></i>
            </a>
        </div>
    </div>
     </div>
