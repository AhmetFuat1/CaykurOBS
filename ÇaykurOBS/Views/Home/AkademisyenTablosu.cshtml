@{
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<div class="custom-table-container">
    <h1 class="style__title">Akademisyen Listesi</h1>
    <div class="arama-kapsayici">
        <button type="button" id="temizle-btn" class="arama-temizle-btn" style="display:none;">&#10005;</button>
        <div class="arama-input-kutu">
            <input type="text" class="arama-input" id="arama-input" placeholder="Ara...🔎">
        </div>
        <button type="button" class="arama-btn" onclick="aramaYap()">Ara</button>
    </div>
    <table class="custom-table" id = "tablo">
        <thead>
            <tr>
                <th onclick="sirala(0)" style="cursor: pointer; user-select: none;">
                    Akademisyen İsmi <span class="sirala-ikon"> ↕️</span>
                </th>
                <th onclick="sirala(1)" style="cursor: pointer; user-select: none;">
                    Akademisyen Soyismi <span class="sirala-ikon"> ↕️</span>
                </th>
                <th>Akademisyen Numarası</th>
                <th>Akademisyen Epostası</th>
                <th onclick="sirala(4)" style="cursor: pointer; user-select: none;">
                    Durum <span class="sirala-ikon"> ↕️</span>
                </th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count > 0)
            {
                @foreach (var akdmsyn in Model)
                {
                    <tr>
                        <td>@akdmsyn.AkademisyenIsim</td>
                        <td>@akdmsyn.AkademisyenSoyisim</td>
                        <td>@akdmsyn.AkademisyenNumarasi</td>
                        <td>@akdmsyn.AkademisyenEmail</td>
                        <td>@akdmsyn.AkademisyenDurum</td>
                        <td>
                            <a href="/Home/VarsayilanSifreAkademisyen?ID=@akdmsyn.AkademisyenID" class="style__btn-edit">
                                Şifresini Sıfırla
                            </a>

                            <a href="/Home/AkademisyenSilme?ID=@akdmsyn.AkademisyenID" class="style__btn-delete">
                                İlişiği Kes
                            </a>

                            <a href="/Home/AkademisyenYenidenEkle?ID=@akdmsyn.AkademisyenID" class="style__btn-edit">
                                Yeniden Ekle
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

</div>
<script src="~/js/SiralamaScripti.js"></script>
<script src="~/js/AramaScripti.js"></script>