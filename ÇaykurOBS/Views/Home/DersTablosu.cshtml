@{
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<div class="custom-table-container">
    <h1 class="style__title">Akademisyen Listesi</h1>
    <table class="custom-table">
        <thead>
            <tr>
                <th>Ders İsmi</th>
                <th>Kredisi</th>
                <th>Dersi Veren Akademisyen</th>
                <th>Ders Kodu</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count > 0)
            {
                @foreach (var drs in Model)
                {
                    <tr>
                        <td>@drs.DersAdi</td>
                        <td>@drs.DersKredisi</td>
                        <td>@drs.OgretmenAdiSoyadi</td>
                        <td>@drs.DersKodu</td>
                        <td>
                            <a href="/Home/DersDuzenleme?ID=@drs.DersID" class="style__btn-edit">
                                Yönet
                            </a>

                            <a href="/Home/DersSilme?ID=@drs.DersID" class="style__btn-delete">
                                Sil
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>