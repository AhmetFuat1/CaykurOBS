@{
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<div class="custom-table-container">
    <h1 class="style__title">Öğrenci Listesi</h1>
    <table class="custom-table">
                <thead>
                    <tr>
                        <th>Öğrenci İsmi</th>
                        <th>Öğrenci Soyismi</th>
                        <th>Öğrenci Numarası</th>
                        <th>Öğrenci Epostası</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count > 0)
                      {
                          @foreach (var ogr in Model)
                          {
                          <tr>
                              <td>@ogr.Isim</td>
                              <td>@ogr.Soyisim</td>
                              <td>@ogr.OgrenciNumarasi</td>
                              <td>@ogr.Email</td>
                              <td>@ogr.Durum</td>
                        <td>
                            <a href="/Home/VarsayilanSifreOgrenci?ID=@ogr.OgrenciID" class="style__btn-edit">
                                Şifresini Sıfırla
                            </a>

                            <a href="/Home/OgrenciSilme?ID=@ogr.OgrenciID" class="style__btn-delete">
                                İlişiği Kes
                            </a>

                            <a href="/Home/OgrenciYenidenEkle?ID=@ogr.OgrenciID" class="style__btn-edit">
                                Yeniden Ekle
                            </a>
                        </td>
                          </tr>
                          }
                      }
        </tbody>
            </table>

    </div>