@{
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

    <div class="style">  
        <h1 class="style__title">Öğrenci Listesi</h1>
            <table>
                <thead>
                    <tr>
                        <th>Öğrenci İsmi</th>
                        <th>Öğrenci Soyismi</th>
                        <th>Öğrenci Numarası</th>
                        <th>Öğrenci Epostası</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count > 0)
                      {
                          @foreach (var ogr in Model)
                          {
                          <tr>
                              <td>@ogr.Isim</td>
                              <td>@ogr.Soyisim</td>
                              <td>@ogr.OgrenciNumarasi</td>
                              <td>@ogr.Email</td>
                        <td>
                            <a href="#E5" class="">
                               Yönet
                            </a>

                            <a href="/Home/VarsayilanSifreOgrenci?ID=@ogr.OgrenciID" class="">
                                Şifresini Sıfırla
                            </a>

                            <a href="/Home/OgrenciSilme?ID=@ogr.OgrenciID" class="">
                                Sil
                            </a>
                        </td>
                          </tr>
                          }
                      }
        </tbody>
            </table>

    </div>