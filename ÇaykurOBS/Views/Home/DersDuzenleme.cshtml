@{
    Layout = "~/Views/Shared/AdminLayout.cshtml";
    var dersiAlanOgrenciler = ViewBag.DersiAlanOgrenciler as List<ÇaykurOBS.Models.DersveNotlar>;
}
    <div style="display: flex; gap: 30px; align-items: flex-start; margin-top: 20px;">

    <div class="style" style="margin: 0; flex: 1; max-width: 450px;">

        <form action="/Home/DersDuzenleme" class="style__form" method="post">
        <h1 class="style__title">Ders Düzenleme Ekranı</h1>
         
            @if (ViewBag.HataMesaji != null)
            {
                <div class="style__viewbag">
                    @ViewBag.HataMesaji
                </div>
            }
            <div class="style__content">
                <div class="style__box">
                    <i class="bx bx-lock-alt"></i>

                <input type="hidden" name="DersID" value="@Model.DersID" />

                    <div class="style__box-input">
                        <input type="text" required class="style__input" name="DersKodu" value="@Model.DersKodu" maxlength="5" placeholder=" ">
                        <label class="style__label">Ders Kodu</label>
                    </div>
                </div>
                <div class="style__box">
                    <i class="bx bx-lock-alt"></i>

                    <div class="style__box-input">
                        <input type="text" required class="style__input" name="DersAdi" value="@Model.DersAdi" placeholder=" ">
                        <label class="style__label">Ders Adı</label>
                    </div>
                </div>

                <div class="style__box">
                    <i class="bx bx-lock-alt"></i>

                    <div class="style__box-input">
                        <input type="number" required class="style__input" name="DersKredisi" value="@Model.DersKredisi" placeholder=" ">
                        <label class="style__label">Ders Kredisi</label>
                    </div>
                </div>
            <div class="style__box">
                <i class="bx bx-user"> </i>
                <div class="style__box-input">
                    <select name="OgretmenID" required class="style__input custom-select">
				@if (ViewBag.Akademisyenler != null)
                {
                    @foreach(var akdmsyn in (List<ÇaykurOBS.Models.Akademisyen>)ViewBag.Akademisyenler)
                    {
                        <option value="@akdmsyn.AkademisyenID">
						@akdmsyn.AkademisyenIsim @akdmsyn.AkademisyenSoyisim
                        </option>
                    }
                }
                </select>
                </div>
            </div>
            </div>

            <button type="submit" class="style__button">Dersi Düzenle</button> 

        </form>
    </div>

    <div class="custom-table-container" style="margin: 0; flex: 1.5;">
    <h1 class="style__title">Ders Kaydı</h1>
    <table class="custom-table">
        <thead>
            <tr>
                <th>Öğrenci Adı Soyadı</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (dersiAlanOgrenciler != null && dersiAlanOgrenciler.Count > 0)
            {
                @foreach (var drsogr in dersiAlanOgrenciler)
                {
                    <tr>
                        <td>@drsogr.OgrenciAdiSoyadi</td>
                        <td>  
                            <a href="/Home/OnayliDersSilme?DersID=@drsogr.DersID&OgrenciID=@drsogr.OgrenciID" class="style__btn-delete">
                                Sil
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

</div>


